# Salin berkas ini menjadi .env.local lalu isi nilainya di sana.
# JANGAN pernah menulis nilai sungguhan di berkas ini — .env.example ikut ter-commit ke git.

# Neon Postgres → Dashboard → Connection string
DATABASE_URL=

# Buat dengan: openssl rand -base64 32
AUTH_SECRET=

# Cloudinary → Dashboard → API Environment variable.
# Satu baris berisi api_key, api_secret, dan cloud_name sekaligus sehingga
# ketiganya dijamin cocok: cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL=

# Di produksi: https://lians.id dan https://admin.lians.id
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_ADMIN_URL=http://admin.localhost:3000

# Hanya dibaca oleh `npm run db:seed`. Tidak perlu diatur di Vercel.
SEED_ADMIN_EMAIL=admin@lians.id
SEED_ADMIN_PASSWORD=
